# Lunatic Announcer service — Railway environment variables.
# Copy the ones you need into the Railway service's Variables tab.

# ---------------------------------------------------------------------------
# The three free models
# ---------------------------------------------------------------------------
# Clients ask for an ALIAS (free-fast / free-balanced / free-colour); this file
# maps each alias to a real upstream model. That indirection is the point: you
# can swap or reprice an upstream model without shipping a new version of the
# mod, which otherwise only updates when a user downloads a new zip.
#
# An alias with no model id or no API key is simply not offered, so a partly
# configured deployment serves fewer models rather than 404ing at runtime.

# free-fast — the default. Verified model id.
FAST_PROVIDER=anthropic
FAST_MODEL=claude-haiku-4-5-20251001
FAST_API_KEY=sk-ant-...

# free-balanced — set MODEL to whatever your account actually has.
BALANCED_PROVIDER=openai
BALANCED_MODEL=
BALANCED_BASE_URL=https://api.openai.com/v1
BALANCED_API_KEY=

# free-colour — Gemini through its OpenAI-compatible endpoint.
# NOTE: Gemini thinks by default and thinking bills against the output cap, so
# a model that cannot suppress it returns nothing at MAX_OUTPUT_TOKENS. Use a
# Flash-class model; 2.5 Pro has a 128-token thinking floor and will not work.
COLOUR_PROVIDER=openai
COLOUR_MODEL=
COLOUR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
COLOUR_API_KEY=

DEFAULT_MODEL_ALIAS=free-fast

# ---------------------------------------------------------------------------
# Limits — these are what make a free tier survivable
# ---------------------------------------------------------------------------

# THE MOST IMPORTANT SETTING IN THIS FILE. Per-user quotas do not bound the
# bill; a thousand users each behaving normally still costs a thousand users'
# worth. This caps the whole day's spend and refuses free calls past it.
DAILY_BUDGET_USD=5

# Used only to run the breaker. Set these NO LOWER than reality or it trips late.
COST_INPUT_PER_1M=1
COST_OUTPUT_PER_1M=5

# ~150 calls is about one hour of racing at the mod's default cadence.
FREE_CALLS_PER_MONTH=150
BURST_CALLS=10
BURST_WINDOW_SEC=60

# Hard ceiling on output tokens whatever the client asks for. The mod asks for
# 60; commentary is one sentence.
MAX_OUTPUT_TOKENS=120

# A real race payload is ~4KB. This is what stops the endpoint being used as a
# general-purpose LLM proxy.
MAX_PROMPT_CHARS=16000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# WITHOUT THIS, QUOTAS AND THE SPEND BREAKER LIVE IN PROCESS MEMORY AND RESET
# ON EVERY DEPLOY AND RESTART. Fine for local development, not for a public
# free tier. Add Railway's Redis plugin and it injects REDIS_URL for you.
# GET /healthz reports which backend is live.
REDIS_URL=

# Signs anonymous device tokens. Unset means a random per-boot secret, so every
# restart invalidates every client's token. Set it before going public.
TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
PORT=8080
# The mod runs in Sauce's Electron renderer, whose origin varies per install.
# The endpoint is bearer-authenticated, so a permissive origin grants nothing
# by itself.
ALLOWED_ORIGIN=*

# ---------------------------------------------------------------------------
# Accounts — NOT IMPLEMENTED YET
# ---------------------------------------------------------------------------
# Planned: Discord OAuth, which then unlocks custom prompts for licence holders.
# Setting these does nothing today; hasAccounts() reports whether they are
# present so config can land before the code.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
